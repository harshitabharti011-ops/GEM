# BASELINE path: synthesise the macros into ordinary logic.
#
# Same RTL as the native path, but instead of reading the blackboxes from
# gem_macros.v we read the behavioural bodies from gem_macros_behav.v as
# ordinary modules. Yosys then expands the DSP multiplier, the carry chain and
# the shift register into AIG cells, exactly as stock GEM requires.
#
# This is what makes the comparison honest: one source design, two synthesis
# scripts, and the only difference is whether the macros survive. Nothing about
# the RTL, the testbench or the input VCD changes between the two runs.
#
# Placeholders are filled in by synth/run_synth.sh --shred.

read_verilog -sv synth/gem_macros_behav.v
read_verilog -sv synth/macro_normalize.v
read_verilog -sv synth/tests/macro_smoke.sv

hierarchy -check -top macro_smoke

# No blackboxes and no `keep`: the macros are ordinary logic here and SHOULD be
# flattened. That is the point of the baseline.
proc;;
opt_expr; opt_dff; opt_clean
memory -nomap
memory_libmap -lib aigpdk/memlib_yosys.txt -logic-cost-rom 100 -logic-cost-ram 100

stat
write_verilog -noattr build_shred/memory_mapped.v
