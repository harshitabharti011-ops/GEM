# BASELINE step 2 -- logic synthesis to aigpdk, macros deliberately shredded.
# Follows usage.md Step 2 (Yosys variant). Placeholders filled by run_synth.sh.
#
# Identical to the native step 2 except that nothing protects the macros:
# they arrive as ordinary logic and abc covers them with AIG cells. Any
# difference in the measured result between the two paths is therefore
# attributable to the macros and to nothing else in the flow.

read_verilog -noautowire build_shred/memory_mapped.v
hierarchy -check -top macro_smoke

synth -flatten
delete t:$print

dfflibmap -liberty aigpdk/aigpdk_nomem.lib
opt_clean -purge
abc -liberty aigpdk/aigpdk_nomem.lib
opt_clean -purge
techmap
abc -liberty aigpdk/aigpdk_nomem.lib
opt_clean -purge

stat

# .gv is what GEM's Rust parser reads. -noattr because sverilogparse does not
# want Yosys attribute comments.
write_verilog -noattr build_shred/gatelevel.gv
# JSON as well: PS note 4 requires the scripts be compatible with Yosys 0.68
# JSON netlist output, and it is far easier to grep than Verilog.
write_json build_shred/gatelevel.json
